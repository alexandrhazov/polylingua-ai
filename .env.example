# --- Translate Me Like Native! environment template ---
# Copy to `.env` for local development: cp .env.example .env

# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Groq API key (https://console.groq.com/keys) — free, no card required
GROQ_API_KEY=gsk_...

# Async Postgres URL (e.g. a free Neon project: https://neon.tech).
# Must use the asyncpg driver scheme, and ssl=require works with Neon's pooler.
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require

# Public HTTPS base URL Telegram will POST updates to.
# Local dev: run `ngrok http 8000` and paste the https URL here.
# Production: your Render service URL, e.g. https://polylingua-ai.onrender.com
WEBHOOK_URL=https://your-tunnel-or-service.example.com

# Optional shared secret; Telegram echoes it in a header so the app can reject
# spoofed webhook calls. Leave blank to disable the check locally.
WEBHOOK_SECRET=

# --- Optional overrides (sensible defaults in app/config.py) ---
# APP_NAME=Translate Me Like Native!
# MODEL=llama-3.3-70b-versatile
# TEMPERATURE=0.3
# MAX_TOKENS=1024
# ROUND_SIZE=3
